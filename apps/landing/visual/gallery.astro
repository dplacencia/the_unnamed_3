---
import { locales } from "../src/i18n/locales";
const names = {
  es: "Español",
  en: "English",
  ca: "Català",
  gl: "Galego",
  eu: "Euskara",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Catálogo técnico Astro</title>
    <style>
      :root {
        color-scheme: light;
        font:
          16px/1.5 system-ui,
          sans-serif;
        color: #20242b;
        background: #f5f5f5;
      }
      body {
        margin: 0;
        padding: 24px;
      }
      main {
        max-width: 1100px;
        margin: auto;
      }
      h1 {
        margin: 0;
        font-size: 1.6rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
        gap: 20px;
      }
      article {
        background: white;
        border: 1px solid #d6d6d6;
        border-radius: 8px;
        padding: 16px;
      }
      h2 {
        margin: 0 0 12px;
        font-size: 1.1rem;
      }
      iframe {
        width: 100%;
        height: 200px;
        border: 1px solid #d6d6d6;
        background: white;
      }
      a {
        color: #204ca5;
      }
      .notice {
        border-inline-start: 4px solid #777;
        padding: 12px;
        background: #eaeaea;
        margin: 20px 0;
      }
    </style>
  </head>
  <body>
    <main data-visual-gallery>
      <h1>Catálogo técnico Astro</h1>
      <p>
        Previsualizaciones de los documentos reales del landing. Esta interfaz
        de revisión no forma parte del producto.
      </p>
      <p class="notice">
        La base actual está vacía y pendiente de diseño. Las capturas en blanco
        verifican únicamente el documento y el idioma; no representan un landing
        terminado.
      </p>
      <section class="grid" aria-label="Documentos por idioma">
        {locales.map((locale) => (
          <article>
            <h2>Foundation · {names[locale]}</h2>
            <iframe
              title={`Foundation ${locale}`}
              src={`/__visual/foundation/${locale}/`}
            ></iframe>
            <p>
              <a href={`/__visual/foundation/${locale}/`}>
                Abrir componente completo
              </a>
            </p>
            <p>
              <a href={locale === "es" ? "/" : `/${locale}/`}>
                Abrir vista del landing
              </a>
            </p>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>
