{
  "name": "the-unnamed-3",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.18.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.1.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:tooling": "eslint . --max-warnings 0",
    "lint:landing": "pnpm --filter ./apps/landing lint",
    "lint": "pnpm lint:tooling && pnpm lint:backoffice && pnpm lint:landing",
    "typecheck": "pnpm typecheck:backoffice && pnpm typecheck:landing && pnpm typecheck:visual",
    "test": "pnpm test:backoffice && pnpm visual:test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:storybook": "pnpm --filter ./apps/backoffice storybook",
    "build:storybook": "pnpm --filter ./apps/backoffice build-storybook",
    "typecheck:visual": "tsc --project visual/tsconfig.json",
    "visual:install-browser": "node visual/cli.mjs install",
    "visual:prepare": "node visual/prepare.mjs",
    "visual:preview": "node visual/serve.ts",
    "visual:coverage": "node visual/coverage.ts",
    "visual:test": "vitest run --config visual/vitest.config.mts",
    "visual:test-languages": "node visual/cli.mjs languages",
    "visual:capture": "node visual/cli.mjs capture",
    "visual:compare": "node visual/cli.mjs compare",
    "visual:ui": "node visual/cli.mjs ui",
    "visual:review": "node scripts/preview-static.mjs .cache/visual --port 9324",
    "visual:report": "node visual/cli.mjs report",
    "visual:approve": "node visual/cli.mjs approve",
    "dev:backoffice": "pnpm --filter ./apps/backoffice dev",
    "build:backoffice": "pnpm --filter ./apps/backoffice build",
    "preview:backoffice": "pnpm --filter ./apps/backoffice preview",
    "lint:backoffice": "pnpm --filter ./apps/backoffice lint",
    "typecheck:backoffice": "pnpm --filter ./apps/backoffice typecheck",
    "test:backoffice": "pnpm --filter ./apps/backoffice test",
    "dev:landing": "pnpm --filter ./apps/landing dev",
    "build:landing": "pnpm --filter ./apps/landing build",
    "preview:landing": "pnpm --filter ./apps/landing preview",
    "typecheck:landing": "pnpm --filter ./apps/landing typecheck"
  }
}
